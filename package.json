{
	"name": "cosmonauts",
	"version": "0.1.0",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"themes": [
			"./themes"
		]
	},
	"bin": {
		"cosmonauts": "./bin/cosmonauts"
	},
	"files": [
		"lib/",
		"cli/",
		"bin/",
		"themes/",
		"stryker.config.mjs",
		"patches/"
	],
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"compile:drive-step": "bun build --compile lib/driver/run-step.ts --outfile bin/cosmonauts-drive-step",
		"test": "node ./scripts/vitest-runner.mjs",
		"test:watch": "vitest",
		"test:mutation": "STRYKER_VITEST_POOL=forks stryker run stryker.config.mjs",
		"test:coverage": "vitest run --coverage",
		"check:reachability": "bun scripts/check-reachability.ts",
		"check:suppressions": "bun scripts/check-new-suppressions.ts",
		"refresh:fallow-baselines": "bun scripts/update-fallow-baselines.ts",
		"probe:census": "bun scripts/probe-census.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.0.3",
		"@earendil-works/pi-ai": "1.0.3",
		"@earendil-works/pi-coding-agent": "1.0.3",
		"@earendil-works/pi-tui": "1.0.3",
		"commander": "^14.0.2",
		"gray-matter": "^4.0.3",
		"typebox": "1.1.33",
		"typescript": "^5.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"fallow": "2.54.2",
		"jsdom": "29.1.1",
		"vitest": "^3.0.0"
	},
	"patchedDependencies": {
		"@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator%2Fvitest-runner@10.0.0.patch"
	},
	"exports": {
		".": "./lib/index.ts",
		"./agents": "./lib/agents/index.ts",
		"./lib/agents/index.ts": "./lib/agents/index.ts",
		"./analysis": "./lib/analysis/index.ts",
		"./lib/analysis/index.ts": "./lib/analysis/index.ts",
		"./artifact-viewer": "./lib/artifact-viewer/index.ts",
		"./lib/artifact-viewer/index.ts": "./lib/artifact-viewer/index.ts",
		"./architecture-map": "./lib/architecture-map/index.ts",
		"./lib/architecture-map/index.ts": "./lib/architecture-map/index.ts",
		"./config": "./lib/config/index.ts",
		"./lib/config/index.ts": "./lib/config/index.ts",
		"./domains": "./lib/domains/index.ts",
		"./lib/domains/index.ts": "./lib/domains/index.ts",
		"./durable-runtime": "./lib/durable-runtime/index.ts",
		"./lib/durable-runtime/index.ts": "./lib/durable-runtime/index.ts",
		"./envelope": "./lib/envelope/index.ts",
		"./lib/envelope/index.ts": "./lib/envelope/index.ts",
		"./artifacts": "./lib/artifacts/index.ts",
		"./lib/artifacts/index.ts": "./lib/artifacts/index.ts",
		"./memory": "./lib/memory/index.ts",
		"./lib/memory/index.ts": "./lib/memory/index.ts",
		"./packages": "./lib/packages/index.ts",
		"./lib/packages/index.ts": "./lib/packages/index.ts",
		"./plans": "./lib/plans/index.ts",
		"./lib/plans/index.ts": "./lib/plans/index.ts",
		"./prompts": "./lib/prompts/index.ts",
		"./lib/prompts/index.ts": "./lib/prompts/index.ts",
		"./sessions": "./lib/sessions/index.ts",
		"./lib/sessions/index.ts": "./lib/sessions/index.ts",
		"./skills": "./lib/skills/index.ts",
		"./lib/skills/index.ts": "./lib/skills/index.ts",
		"./runtime": "./lib/runtime.ts",
		"./lib/runtime.ts": "./lib/runtime.ts",
		"./orchestration/agent-spawner": "./lib/orchestration/agent-spawner.ts",
		"./lib/orchestration/agent-spawner.ts": "./lib/orchestration/agent-spawner.ts",
		"./orchestration/chain-profiler": "./lib/orchestration/chain-profiler.ts",
		"./lib/orchestration/chain-profiler.ts": "./lib/orchestration/chain-profiler.ts",
		"./orchestration/definition-resolution": "./lib/orchestration/definition-resolution.ts",
		"./lib/orchestration/definition-resolution.ts": "./lib/orchestration/definition-resolution.ts",
		"./orchestration/message-bus": "./lib/orchestration/message-bus.ts",
		"./lib/orchestration/message-bus.ts": "./lib/orchestration/message-bus.ts",
		"./orchestration/session-factory": "./lib/orchestration/session-factory.ts",
		"./lib/orchestration/session-factory.ts": "./lib/orchestration/session-factory.ts",
		"./orchestration/spawn-tracker": "./lib/orchestration/spawn-tracker.ts",
		"./lib/orchestration/spawn-tracker.ts": "./lib/orchestration/spawn-tracker.ts",
		"./orchestration/types": "./lib/orchestration/types.ts",
		"./lib/orchestration/types.ts": "./lib/orchestration/types.ts",
		"./packages/scanner": "./lib/packages/scanner.ts",
		"./lib/packages/scanner.ts": "./lib/packages/scanner.ts",
		"./runtime-host": "./lib/runtime-host.ts",
		"./chains": "./lib/chains/index.ts",
		"./orchestration/chain-runner": "./lib/orchestration/chain-runner.ts",
		"./orchestration/durable-chain-runner": "./lib/orchestration/durable-chain-runner.ts",
		"./extensions/orchestration": "./lib/extensions/orchestration/index.ts"
	}
}
